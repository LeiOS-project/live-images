#!/bin/bash

set -e

# LeiOS keyring is shipped via includes.chroot/usr/share/keyrings/leios-public-key.gpg
# and trusted during the live-build via config/archives/leios.key.chroot.
# It is intentionally not downloaded here so the build does not depend on the repo being online.

# Firefox keyring is shipped via includes.chroot/usr/share/keyrings/packages.mozilla.org.asc
# and trusted during the live-build via config/archives/mozilla.key.chroot.
# It is intentionally not downloaded here so the build does not depend on the repo being online.
